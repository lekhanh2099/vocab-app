{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "feature/google-sheet-data-source": false
    }
  },
  "rewrites": [
    {
      "source": "/api/vocabulary",
      "destination": "/api/vocabulary.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
