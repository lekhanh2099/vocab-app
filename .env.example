# Private Google Sheet via Apps Script Web App.
# Copy this file to .env.local; never commit real secrets.

# Deploy apps-script/Code.gs as a Web App: Execute as Me, Who has access: Anyone.
APPS_SCRIPT_VOCAB_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Must match Apps Script Project Settings -> Script Properties -> VOCAB_API_SECRET.
# Use a long random value (24+ characters; 32+ recommended).
APPS_SCRIPT_VOCAB_SECRET=replace-with-a-long-random-secret
